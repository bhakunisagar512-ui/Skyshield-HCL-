# Copy to backend/.env and adjust. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://skyshield:skyshield@localhost:5433/skyshield

# Use a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# AI summary + measures
#   mock      -> offline, builds measures straight from the policy text (no key needed)
#   anthropic -> needs ANTHROPIC_API_KEY (default model claude-haiku-5-5, the cheapest)
#   openai    -> needs OPENAI_API_KEY (set LLM_MODEL)
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings for policy search
#   hash   -> offline, keyword-style (default)
#   openai -> text-embedding-3-small. Re-run `python -m app.seed --policies-only` after switching.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=6
